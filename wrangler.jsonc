{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nota",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-19",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Deep links (/sak/..., /arkiv) fall back to index.html.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    {
      "binding": "NEWS_KV",
      // Replace with a real namespace id before `wrangler deploy`.
      "id": "local-placeholder-replace-before-deploy"
    }
  ]
}
